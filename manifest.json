{
  "apiVersion": 1,
  "runtime": "javascript",
  "id": "com.ai-canvas.video-frame-review",
  "name": "逐帧拉片",
  "version": "1.0.0",
  "author": "AI-Canvas Contributors",
  "description": "从当前视频节点选择时间点，批量抽帧并用视觉模型生成可编辑的分镜表或图片节点。",
  "license": "MIT",
  "category": "media",
  "keywords": [
    "video",
    "frame",
    "shotlist",
    "analysis"
  ],
  "entry": "main.js",
  "permissions": [
    "node.read",
    "node.write",
    "models.read",
    "models.invoke",
    "files.connected.read",
    "files.output.create",
    "ui.custom"
  ],
  "ui": {
    "entry": "ui.js",
    "integrity": "sha256-201bfa4cffc116dc0d795ac5956400735fe028fcee4ff7123e0d19c3a41810e0",
    "exports": {
      "frameReview": "VideoFrameReview"
    }
  },
  "contributes": {
    "nodeTools": [
      {
        "id": "video-frame-review",
        "title": "逐帧拉片",
        "description": "按指定时间点抽取视频画面，调用视觉模型分析镜头并生成分镜表或图片节点。",
        "placements": [
          "node-toolbar",
          "node-context-menu"
        ],
        "icon": "lucide:gallery-horizontal-end",
        "dialog": {
          "title": "逐帧拉片",
          "description": "选择时间点与视觉模型，分析后可编辑并一次生成节点。",
          "submitLabel": "生成节点",
          "fields": [
            {
              "id": "model",
              "label": "视觉文本模型",
              "type": "model",
              "modelCategories": [
                "text"
              ],
              "required": true
            },
            {
              "id": "prompt",
              "label": "分析要求",
              "type": "textarea",
              "defaultValue": "请按镜头语言分析每一帧：景别、运镜、画面内容、可见台词线索、声音线索、转场建议与备注。仅依据画面判断；无法确认的台词和声音必须写“无法从画面判断”。"
            }
          ],
          "ui": "frameReview",
          "presentation": "window"
        },
        "nodeTypes": [
          "ai-video",
          "source-video"
        ],
        "inputFields": [
          "label"
        ],
        "resourceAccess": {
          "self": true
        },
        "output": {
          "mode": "create-node-set",
          "nodeTypes": [
            "ai-image",
            "ai-shotlist"
          ],
          "maxNodes": 25,
          "fields": [
            "label",
            "imageWidth",
            "imageHeight",
            "frameAnalysis",
            "shotlistRows"
          ]
        }
      }
    ]
  }
}
